---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all news and separate pinned from regular
const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const pinnedNews = sortedNews.filter(news => news.data.pinned);
const regularNews = sortedNews.filter(news => !news.data.pinned);

// 計算輪播區應該顯示的數量（總共顯示 5 個）
const maxTotalItems = 5;
const carouselVisibleCount = Math.max(0, maxTotalItems - pinnedNews.length);
const carouselHeight = carouselVisibleCount * 30; // 每個項目 30px
---

<BaseLayout 
  pageTitle="Home"
  description="Advanced Database System Laboratory at NYCU — Spatial-Temporal Data Mining, Sport Data Analysis, Deep Learning in GNN/NLP, and Data Management"
>
  <div class="bg-white">
    <!-- Hero Section -->
    <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0">
        <img 
          src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2134&q=80" 
          alt="Advanced Database Technology" 
          class="w-full h-full object-cover"
        />
        <!-- Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-br from-blue-900/80 via-blue-800/70 to-indigo-900/80"></div>
      </div>
      
      <!-- Background Elements -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/5 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-blue-300/5 rounded-full blur-2xl animate-pulse" style="animation-delay: 4s;"></div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <div class="max-w-4xl mx-auto">
          <!-- Logo -->
          <div class="mb-8">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-white backdrop-blur-sm rounded-2xl border border-white/20 shadow-2xl">
              <img src={`${import.meta.env.BASE_URL}logo.png`} alt="ADSL" class="w-16 h-16 drop-shadow-lg" />
            </div>
          </div>
          
          <!-- Title -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
            Advanced Database System
            <span class="block text-blue-200">Laboratory</span>
          </h1>
          
          <!-- Subtitle -->
          <p class="text-xl sm:text-2xl text-blue-100 mb-4 font-light">
            National Yang Ming Chiao Tung University
          </p>
          
        
          
          <!-- Scroll Indicator -->
          <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
            <svg class="w-6 h-6 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </div>
        </div>
      </div>
    </section>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">

      <!-- Latest News Section -->
      <section class="mb-20">
        <div class="max-w-8xl mx-auto bg-gray-50/50 rounded-lg p-6">
          <!-- 置頂新聞（固定顯示，不參與輪播） -->
          {pinnedNews.length > 0 && (
            <div class="space-y-2 mb-2">
              {pinnedNews.map((news) => (
                <a 
                  href={`${import.meta.env.BASE_URL}news/${news.slug}`} 
                  class="flex items-center justify-between text-sm hover:bg-gray-50 px-2 py-1 rounded transition-colors block"
                  style="height: 30px;"
                >
                  <span class="text-gray-900 flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M16 12V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v8l-2 2v2h5v6l1 1 1-1v-6h5v-2l-2-2z"/>
                    </svg>
                    <span class="font-medium">{news.data.title}</span>
                  </span>
                  <span class="text-gray-500 ml-4 whitespace-nowrap">
                    {news.data.date.toLocaleDateString('en-US', { 
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </span>
                </a>
              ))}
            </div>
          )}
          
          <!-- 一般新聞輪播區 -->
          {regularNews.length > 0 && carouselVisibleCount > 0 && (
            <div class="overflow-hidden relative" style={`height: ${carouselHeight}px;`} id="news-carousel-container">
              <div id="news-carousel" class="transition-transform duration-500 ease-in-out">
                <!-- 原始新聞列表 -->
                {regularNews.map((news) => (
                  <a 
                    href={`${import.meta.env.BASE_URL}news/${news.slug}`} 
                    class="flex items-center justify-between text-sm hover:bg-gray-50 px-2 py-1 rounded transition-colors block"
                    style="height: 30px;"
                  >
                    <span class="text-gray-900">{news.data.title}</span>
                    <span class="text-gray-500 ml-4 whitespace-nowrap">
                      {news.data.date.toLocaleDateString('en-US', { 
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </span>
                  </a>
                ))}
                <!-- 複製新聞列表以實現無縫循環 -->
                {regularNews.map((news) => (
                  <a 
                    href={`${import.meta.env.BASE_URL}news/${news.slug}`} 
                    class="flex items-center justify-between text-sm hover:bg-gray-50 px-2 py-1 rounded transition-colors block"
                    style="height: 30px;"
                  >
                    <span class="text-gray-900">{news.data.title}</span>
                    <span class="text-gray-500 ml-4 whitespace-nowrap">
                      {news.data.date.toLocaleDateString('en-US', { 
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <script define:vars={{ totalNewsCount: regularNews.length, visibleCount: carouselVisibleCount }}>
        // 新聞輪播功能（僅當有一般新聞且輪播區有空間時才執行）
        if (totalNewsCount > 0 && visibleCount > 0) {
          const carousel = document.getElementById('news-carousel');
          const container = document.getElementById('news-carousel-container');
          let currentIndex = 0;
          let intervalId;
          let isPaused = false;

          const itemHeight = 30; // 每個新聞項目的高度（px）
          const totalItems = totalNewsCount; // 新聞總數（動態）

          // 滾動到指定索引
          function scrollToIndex(index) {
            const offset = -(index * itemHeight);
            if (carousel) {
              carousel.style.transform = `translateY(${offset}px)`;
            }
          }

          // 自動滾動到下一個新聞
          function scrollToNext() {
            if (isPaused) return;

            currentIndex++;
            scrollToIndex(currentIndex);

            // 當滾動到複製的列表時，等待動畫完成後瞬間切回原始位置
            if (currentIndex >= totalItems) {
              setTimeout(() => {
                if (carousel) {
                  carousel.style.transition = 'none';
                  currentIndex = 0;
                  scrollToIndex(0);
                  
                  // 恢復過渡效果
                  setTimeout(() => {
                    if (carousel) {
                      carousel.style.transition = 'transform 500ms ease-in-out';
                    }
                  }, 50);
                }
              }, 500); // 等待過渡動畫完成
            }
          }

          // 啟動自動輪播
          function startCarousel() {
            intervalId = window.setInterval(scrollToNext, 2000);
          }

          // 停止自動輪播
          function stopCarousel() {
            if (intervalId) {
              clearInterval(intervalId);
            }
          }

          // 滑鼠懸停時暫停
          if (container) {
            container.addEventListener('mouseenter', () => {
              isPaused = true;
            });

            container.addEventListener('mouseleave', () => {
              isPaused = false;
            });
          }

          // 啟動輪播
          startCarousel();

          // 頁面卸載時清理
          window.addEventListener('beforeunload', () => {
            stopCarousel();
          });
        }
      </script>

      <!-- About Us Section -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">About Our Laboratory</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto mb-6"></div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl border border-blue-100">
              <h3 class="text-2xl font-semibold text-gray-900 mb-4">Laboratory Overview</h3>
              <p class="text-gray-700 leading-relaxed mb-4">
                Our laboratory was established in August 2003 at the Department of Computer Science, National Yang Ming Chiao Tung University, named Advanced Database System Laboratory (ADSL).
              </p>
              <p class="text-gray-700 leading-relaxed">
                Our research areas include spatial-temporal data mining, sport data analysis, deep learning, and data management. We particularly enjoy collaborating with industry to solve urgent real-world problems using data.
              </p>
            </div>
            
          </div>
          
          <div class="space-y-6">
            <div class="bg-white p-8 rounded-2xl shadow-xl border">
              <h3 class="text-2xl font-semibold text-gray-900 mb-6">Industry Collaboration</h3>
              <div class="space-y-4">
                <div class="flex items-start space-x-3">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <p class="text-gray-700">Public transportation mode detection with Microsoft Research Asia</p>
                </div>
                <div class="flex items-start space-x-3">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <p class="text-gray-700">User behavior analysis and modeling with E.Sun Bank</p>
                </div>
                <div class="flex items-start space-x-3">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <p class="text-gray-700">Personalized generation and recommendation with KKday</p>
                </div>
                <div class="flex items-start space-x-3">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <p class="text-gray-700">Sports analysis and athlete training assistance systems</p>
                </div>
                <div class="flex items-start space-x-3">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                  <p class="text-gray-700">Fake news detection technology development</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Research Areas Section -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Research Areas</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto mb-6"></div>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Our research areas cover various important aspects of data science
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="group bg-white p-8 rounded-2xl shadow-lg border hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 text-white flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3a.75.75 0 00-.75.75V6H6.75A.75.75 0 006 6.75v3H3.75a.75.75 0 00-.75.75v6.75c0 .414.336.75.75.75H9a.75.75 0 00.75-.75V15h3v2.25c0 .414.336.75.75.75h5.25a.75.75 0 00.75-.75V9.75a.75.75 0 00-.75-.75H18V6.75a.75.75 0 00-.75-.75H15V3.75A.75.75 0 0014.25 3h-4.5z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Deep Learning</h3>
            <p class="text-gray-600 leading-relaxed">Graph Neural Networks (GNN) and Natural Language Processing (NLP) deep learning techniques</p>
          </div>
          
          <div class="group bg-white p-8 rounded-2xl shadow-lg border hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 text-white flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18M7 15l4-4 4 4 4-4"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Data Mining</h3>
            <p class="text-gray-600 leading-relaxed">Spatial-temporal data mining techniques, exploring patterns in time and space data</p>
          </div>
          
          <div class="group bg-white p-8 rounded-2xl shadow-lg border hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-purple-600 text-white flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4c-2.5 0-4.5 2-4.5 4.5 0 1.8.8 3.4 2.1 4.2l-4.6 7.8M12 4c2.5 0 4.5 2 4.5 4.5 0 1.8-.8 3.4-2.1 4.2l4.6 7.8M12 4v4.5m-4.5 0h9m-9 0c0 2.5 2 4.5 4.5 4.5s4.5-2 4.5-4.5"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Sport Data Analysis</h3>
            <p class="text-gray-600 leading-relaxed">Sports performance analysis and prediction</p>
          </div>
          
          <div class="group bg-white p-8 rounded-2xl shadow-lg border hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-orange-500 to-orange-600 text-white flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Data Management</h3>
            <p class="text-gray-600 leading-relaxed">Database, sensor data, and IoT data management systems</p>
          </div>
        </div>
      </section>

      <!-- Professor Section -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Laboratory Director</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto mb-6"></div>
        </div>
        
        <div class="bg-white overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Professor Photo -->
            <div class="relative w-[300px] h-[300px] mx-auto">
              <img 
                src={`${import.meta.env.BASE_URL}images/professor-peng.jpg`} 
                alt="Prof. Wen-Chih Peng" 
                class="w-full h-full object-cover rounded-xl"
                style="object-position: center 0%;"
              />
            </div>
            
            <!-- Professor Info -->
            <div class="flex flex-col justify-center">
              <div class="mb-8">
                <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-2">Prof. Wen-Chih Peng</h3>
                <p class="text-lg text-blue-600 font-medium mb-4">彭文志教授</p>
                <p class="text-gray-600 font-medium">Laboratory Director & Professor</p>
                <p class="text-sm text-gray-500 mt-2">Department of Computer Science, NYCU</p>
              </div>
              
              <div class="space-y-6 text-gray-700 leading-relaxed">
                <p>
                  Wen-Chih Peng received the BS and MS degrees from the National Chiao Tung University, Taiwan, in 1995 and 1997, respectively, and the Ph.D. degree in Electrical Engineering from the National Taiwan University, Taiwan, R.O.C in 2001. Currently, he is a professor at the department of Computer Science, National Yang Ming Chiao Tung University, Taiwan.
                </p>
                <p>
                  Prior to joining the department of Computer Science and Information Engineering, National Yang Ming Chiao Tung University, he was mainly involved in the projects related to mobile computing, data broadcasting and network data management. Dr. Peng published papers in several prestigious conferences, such as IEEE ICDE, IEEE ICDM and ACM CIKM.
                </p>
                <p>
                  Dr. Peng has the best paper award in ACM Workshop on location-based social network 2009 and the best student paper award in IEEE International Conference on Mobile Data Management 2011. His research interests include mobile computing, network data management and data mining. He is a member of IEEE.
                </p>
              </div>
              
              <div class="mt-8">
                <a href="https://sites.google.com/site/wcpeng/" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-xl font-medium hover:bg-blue-700 transition-colors duration-200 shadow-lg hover:shadow-xl">
                  Personal Page
                  <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>
            </div>
            
          </div>
        </div>
      </section>
    </div>
  </div>