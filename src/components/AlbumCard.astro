---
import type { ImageMetadata } from 'astro';

export interface Props {
  imageSrc: ImageMetadata;
  title: string;
  description?: string | undefined;
  onClick?: string | undefined;
}

const { imageSrc, title, description } = Astro.props as Props;
---

<div class="group relative overflow-hidden rounded-lg shadow-lg cursor-pointer album-card aspect-[4/3] bg-gray-100">
  <img 
    src={imageSrc.src} 
    alt={title}
    class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-50"
  />
  
  <!-- Overlay with title -->
  <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/30 p-4">
    <h3 class="text-white text-xl font-bold text-center drop-shadow-lg">
      {title}
    </h3>
    {description && (
      <p class="text-white text-sm text-center mt-2 drop-shadow-lg line-clamp-2">
        {description}
      </p>
    )}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

